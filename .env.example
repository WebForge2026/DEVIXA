# Supabase project (EU region, e.g. Frankfurt eu-central-1)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Public site origin, used for metadata, hreflang and sitemap
NEXT_PUBLIC_SITE_URL=https://devixa.de

# Google Search Console: value of content="…" from <meta name="google-site-verification">
# (alternatively paste it directly in lib/site.ts → GOOGLE_SITE_VERIFICATION)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Analytics (see lib/analytics.ts): none | plausible | ga4 | gtm
# plausible → no cookie banner; ga4/gtm → loads only after opt-in in the cookie banner
NEXT_PUBLIC_ANALYTICS_PROVIDER=none
NEXT_PUBLIC_ANALYTICS_ID=

# ---------------------------------------------------------------------------
# Admin Command Center (/admin) — REQUIRED in production
# Without these the admin login is disabled online (the repo is public, so
# there are no built-in production credentials).
#   ADMIN_EMAIL           login email (default: admin@devixa.de)
#   ADMIN_PASSWORD        long random password
#   ADMIN_SESSION_SECRET  ≥ 32 random characters, e.g. `openssl rand -base64 48`
# Local `npm run dev` only: admin@devixa.de / devixa-admin-2026
# ---------------------------------------------------------------------------
ADMIN_EMAIL=admin@devixa.de
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Server-side Supabase key for the admin panel, telemetry and CMS (never expose
# to the browser). Without it the admin uses a local JSON file (.data/), which
# is NOT durable on Vercel.
SUPABASE_SERVICE_ROLE_KEY=
